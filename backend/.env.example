# ========================================================
# Jamia Sher-e-Rabbani - Backend Environment Configuration
# ========================================================

# Server Port
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas Cloud Cluster)
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://jamia_admin:YOUR_STRONG_PASSWORD@cluster0.mongodb.net/jamiashererabbani?retryWrites=true&w=majority

# JWT Authentication Secret Key (Minimum 32 random characters for security)
JWT_SECRET=replace_this_with_a_secure_random_string_at_least_32_chars_long

# Cloudinary Storage Configuration (Optional fallback for external cloud CDN)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
